# =============================================================
# perfin_02 - .gitignore
# =============================================================
#
# IMPORTANTE: a pasta .claude/ DEVE ser versionada e enviada ao
# GitHub. Ela contém a configuração compartilhada do Claude Code
# (CLAUDE.md, agents, skills, rules, hooks e settings.json).
# Não adicione .claude/ a este arquivo.
#
# A única exceção é o arquivo de configuração pessoal abaixo.
.claude/settings.local.json

# --- Variáveis de ambiente e credenciais ----------------------
# Nunca versionar: contêm senhas e chaves.
.env
.env.*
!.env.example
*.pem
*.key

# --- Dependências ---------------------------------------------
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# --- Build e cache --------------------------------------------
.next/
out/
dist/
build/
coverage/
.turbo/
.vercel/
*.tsbuildinfo

# --- Logs -----------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Sistema operacional e editores ---------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Arquivos locais com dados sensíveis ----------------------
dados_perfin.txt

# --- Testes Python ---------------------------------------------
.pytest_cache/
