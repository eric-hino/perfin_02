# Modelo de variáveis de ambiente — só os NOMES, nunca valores reais.
# O .env (local) não é versionado. Em produção os valores ficam na Vercel e no GitHub.
# Veja documentacao/configuracao.md.

# --- Portal (projeto Vercel "portal", Root Directory aplicativo/portal) -------
# URL pública do Portal na Vercel (https://<projeto>.vercel.app), sem barra no fim.
NEXT_PUBLIC_SITE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_CLIENT_ID=
# Somente servidor; nunca com prefixo NEXT_PUBLIC_.
GOOGLE_CLIENT_SECRET=
# 32 bytes aleatórios em base64 (cifra AES-256-GCM dos tokens do Google).
GOOGLE_TOKEN_ENCRYPTION_KEY=
# E-mail do administrador principal.
ADMIN_EMAIL=
GEMINI_API_KEY=
# Opcional (padrão: gemini-3.5-flash).
GEMINI_MODEL=

# --- Site (projeto Vercel "site", Root Directory website) ---------------------
# NEXT_PUBLIC_SITE_URL, SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY (mesmos nomes acima,
# com a URL do site), mais a URL do Portal para o botão "Entrar no Portal":
NEXT_PUBLIC_PORTAL_URL=

# --- Coletor (GitHub Actions: Secret do repositório) --------------------------
# Session Pooler do Supabase com o usuário coletor_indicadores.<ref>.
# Gerado por: python aplicativo/supabase/banco.py senha-coletor --github
COLETOR_DATABASE_URL=

# --- Somente local (migrações e testes de RLS) --------------------------------
# Conexão do usuário postgres. Sem IPv6, banco.py usa o Session Pooler sozinho.
DATABASE_URL=
# Opcional: host do Session Pooler (padrão aws-0-sa-east-1.pooler.supabase.com).
SUPABASE_POOLER_HOST=
